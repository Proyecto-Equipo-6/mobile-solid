# Copia este archivo a `.env` y completa los valores.
# Las variables EXPO_PUBLIC_* son públicas (van al bundle de la app).

# --- IP del backend ---
# Para obtener tu IP: ipconfig (Windows) o ifconfig (Mac/Linux)
#
# Ejemplos:
#   Android emulator: http://10.0.2.2:3000/api/v1
#   Celular WiFi:    http://192.168.1.XXX:3000/api/v1
#   Hotspot celular: http://172.20.10.XXX:3000/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000/api/v1
